<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <RuntimeIdentifier Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniBlock\OmniBlock.csproj" />
    <ProjectReference Include="..\OmniBlock.Luau\OmniBlock.Luau.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OmniBlock.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <!--
    Source-checkout bridge until OmniBlock.Luau.Native ships as a RID package. The executable,
    not the referenced class library, is the native loader's probing directory, so content copied
    only into OmniBlock.Luau/bin is not discoverable by the client. Once build-local.sh has created
    the platform artifact, copy it directly beside OmniBlock.Client.dll on every build.
  -->
  <PropertyGroup>
    <_LuauNativeBuildDir>$(MSBuildThisFileDirectory)../native/luau/build</_LuauNativeBuildDir>
    <_LuauNativeLocalArtifact Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(_LuauNativeBuildDir)/libomniblock_luau.so</_LuauNativeLocalArtifact>
    <_LuauNativeLocalArtifact Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(_LuauNativeBuildDir)/libomniblock_luau.dylib</_LuauNativeLocalArtifact>
    <_LuauNativeLocalArtifact Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(_LuauNativeBuildDir)/omniblock_luau.dll</_LuauNativeLocalArtifact>
  </PropertyGroup>

  <Target Name="CopyLocalLuauNative" AfterTargets="Build" Condition="Exists('$(_LuauNativeLocalArtifact)')">
    <Copy SourceFiles="$(_LuauNativeLocalArtifact)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OmniBlock\assets\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!--
    ImGuiImplGLFW.so has RUNPATH $ORIGIN and a NEEDED entry for "libglfw.so", but the
    bundled GLFW from ultz.native.glfw is named "libglfw.so.3". The OS dynamic linker
    looks for the exact filename "libglfw.so" in the same directory, so it fails unless
    that name exists. This target runs after every build and creates it in each Linux
    native output directory that contains "libglfw.so.3".

    It MUST be a symlink, not a copy. Both files carry SONAME "libglfw.so.3", but ld.so
    only collapses two DT_NEEDED requests into one mapping when they resolve to the same
    st_dev/st_ino. A copy is a distinct inode, so "libglfw.so.3" (loaded by Silk.NET, which
    creates the window) and "libglfw.so" (loaded via ImGuiImplGLFW.so's NEEDED entry) map as
    two independent GLFW instances with separate global state. ImGui then registers its
    input callbacks on the second instance while passing a GLFWwindow* owned by the first,
    which that instance has never seen — so the callbacks never fire and the debug overlay
    renders but receives no mouse or keyboard input at all (the WebGPU backend still draws
    fine, since drawing never touches GLFW). A symlink shares the inode and keeps GLFW a
    singleton.
  -->
  <Target Name="CreateGlfwCompatSymlink" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
    <ItemGroup>
      <_GlfwSo3Files Include="$(OutDir)runtimes\linux-*\native\libglfw.so.3" />
      <_GlfwSo3Files Include="$(OutDir)libglfw.so.3" Condition="Exists('$(OutDir)libglfw.so.3')" />
    </ItemGroup>
    <!-- Remove any regular-file copy left by an older build, otherwise the symlink is skipped. -->
    <Delete Files="@(_GlfwSo3Files->'%(RootDir)%(Directory)libglfw.so')" />
    <Exec Command="ln -sfn libglfw.so.3 '%(_GlfwSo3Files.RootDir)%(_GlfwSo3Files.Directory)libglfw.so'" Condition="'@(_GlfwSo3Files)' != ''" />
  </Target>

</Project>
