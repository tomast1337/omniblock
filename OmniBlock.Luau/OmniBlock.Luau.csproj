<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OmniBlock.Luau</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OmniBlock.Tests"/>
  </ItemGroup>

  <!--
    Local dev bridge (docs/luau-ffi-embedding-plan.md Part 1.5) — before the
    OmniBlock.Luau.Native RID package exists (Part 1.4, not built yet), set
    LUAU_NATIVE_LOCAL=1 and this copies the artifact native/luau/build-local.sh
    just produced straight into the output directory, so a bare
    [LibraryImport("omniblock_luau")] resolves it with no packaging step.
    Absent that env var, or if the local build hasn't been run, this ItemGroup
    contributes nothing — a normal build/restore is unaffected either way.
  -->
  <PropertyGroup Condition="'$(LUAU_NATIVE_LOCAL)' == '1'">
    <_LuauNativeBuildDir>$(MSBuildThisFileDirectory)../native/luau/build</_LuauNativeBuildDir>
    <LuauNativeLocalOverride Condition="'$([MSBuild]::IsOSPlatform(Linux))' == 'true'">$(_LuauNativeBuildDir)/libomniblock_luau.so</LuauNativeLocalOverride>
    <LuauNativeLocalOverride Condition="'$([MSBuild]::IsOSPlatform(OSX))' == 'true'">$(_LuauNativeBuildDir)/libomniblock_luau.dylib</LuauNativeLocalOverride>
    <LuauNativeLocalOverride Condition="'$([MSBuild]::IsOSPlatform(Windows))' == 'true'">$(_LuauNativeBuildDir)/omniblock_luau.dll</LuauNativeLocalOverride>
  </PropertyGroup>

  <ItemGroup Condition="'$(LUAU_NATIVE_LOCAL)' == '1' And Exists('$(LuauNativeLocalOverride)')">
    <None Include="$(LuauNativeLocalOverride)" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)"/>
  </ItemGroup>
</Project>
